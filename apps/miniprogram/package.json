{
  "name": "@huanghuang/miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "Huanghuang WeChat mini-program (Taro React)",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@huanghuang/protocol": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "lottie-miniprogram": "1.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-mp": "0.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.2.1",
    "sass": "^1.81.0",
    "typescript": "^5.9.3",
    "webpack": "5.91.0"
  }
}
